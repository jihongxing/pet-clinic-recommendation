.page-shell--map {
  padding-bottom: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.map-panel {
  padding: 22rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.map-panel__title {
  font-size: 32rpx;
  font-weight: 700;
}

.map-panel__action {
  color: #d86b4a;
  font-size: 24rpx;
  font-weight: 600;
}

.map-view {
  width: 100%;
  height: 58vh;
  overflow: hidden;
}

.state-card {
  padding: 44rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  align-items: center;
  text-align: center;
}

.state-card__title {
  font-size: 30rpx;
  color: #2f2925;
  font-weight: 600;
}

.summary-card {
  padding: 24rpx;
}

.summary-card__header,
.summary-card__footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.summary-card__title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.summary-card__name {
  font-size: 32rpx;
  font-weight: 600;
}

.claimed-badge {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #eef8f2;
  color: #2f8e63;
  font-size: 22rpx;
}

.summary-card__address {
  display: block;
  margin-top: 12rpx;
  line-height: 1.6;
}

.summary-card__metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 18rpx 0;
}

.metric-pill {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #eef8f2;
  color: #2f8e63;
  font-size: 24rpx;
}

.metric-pill--value {
  background: #eef4ff;
  color: #4b7bec;
}

.metric-pill--soft {
  background: #faf4ef;
  color: #7a6c63;
}

.summary-card__action {
  color: #d86b4a;
  font-weight: 600;
}
