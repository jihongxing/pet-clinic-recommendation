<view class="page-shell">
  <view class="profile-card card">
    <view class="profile-card__avatar">{{user.nickname ? user.nickname.slice(0, 1) : '宠'}}</view>
    <view class="profile-card__info">
      <text class="profile-card__name">{{isLoggedIn ? (user.nickname || '微信用户') : '游客用户'}}</text>
      <text class="muted">{{isLoggedIn ? (user.city || '已完成登录，可查看个人资料') : '登录后查看完整记录'}}</text>
    </view>
  </view>

  <view class="auth-actions card">
    <button
      wx:if="{{!isLoggedIn}}"
      class="auth-button auth-button--primary"
      loading="{{loading}}"
      bindtap="handleLogin"
    >
      微信登录
    </button>
    <button
      wx:elif="{{isLoggedIn}}"
      class="auth-button"
      bindtap="handleLogout"
    >
      退出登录
    </button>
  </view>

  <view class="menu-list">
    <view
      wx:for="{{menus}}"
      wx:key="key"
      class="menu-item card"
      data-key="{{item.key}}"
      data-page="{{item.page || ''}}"
      bindtap="handleMenuTap"
    >
      <text>{{item.label}}</text>
      <text class="menu-item__arrow">›</text>
    </view>
  </view>
</view>
