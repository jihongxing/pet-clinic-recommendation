.intro-card,
.draft-card,
.form-card {
  padding: 28rpx;
}

.draft-card,
.form-card {
  margin-top: 24rpx;
}

.intro-card__hint {
  display: block;
  margin-top: 10rpx;
  line-height: 1.6;
}

.section-title--compact {
  margin-bottom: 0;
  font-size: 32rpx;
}

.detail-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f2e7df;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-row__label {
  color: #7a6c63;
  font-size: 24rpx;
}

.form-field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 20rpx;
}

.form-field__label {
  color: #5f4d42;
  font-size: 24rpx;
  font-weight: 600;
}

.form-field__input,
.form-field__textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #faf4ef;
  border: 1rpx solid #f0dfd4;
  font-size: 28rpx;
  color: #2f2925;
}

.form-field__textarea {
  min-height: 220rpx;
}

.form-card__submit {
  width: 100%;
  margin-top: 28rpx;
}
