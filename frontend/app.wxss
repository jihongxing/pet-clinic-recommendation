page {
  background: #fdf7f1;
  color: #2f2925;
  font-family:
    'PingFang SC',
    -apple-system,
    BlinkMacSystemFont,
    'Segoe UI',
    sans-serif;
}

.page-shell {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fffdfb;
  border: 1rpx solid #f0dfd4;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(47, 41, 37, 0.06);
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.muted {
  color: #7a6c63;
}

.pill {
  display: inline-block;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #fff1ea;
  color: #d86b4a;
  font-size: 24rpx;
}

.primary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  padding: 0 28rpx;
  border-radius: 20rpx;
  background: #d86b4a;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}
