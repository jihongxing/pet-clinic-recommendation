# ============================================
# Staging deployment environment variables
# Copy to .env.staging before first deploy:
#   Copy-Item .env.staging.example .env.staging
# ============================================

NODE_ENV=production
APP_NAME=pet-clinic-recommendation-backend
API_PREFIX=/api/v1
SWAGGER_ENABLED=false
SWAGGER_PATH=api-docs
DOMAIN_NAME=api-staging.petmed.example.com

DB_USERNAME=petmed
DB_PASSWORD=change_me_to_a_strong_password
DB_DATABASE=pet_clinic_recommendation

REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=replace_with_a_32_char_plus_secret
JWT_EXPIRES_IN=7d

WECHAT_APPID=replace_with_real_appid
WECHAT_SECRET=replace_with_real_secret

STAGING_REVIEW_ADMIN_USERNAME=review_admin
STAGING_REVIEW_ADMIN_PASSWORD=Admin123456!
STAGING_REVIEW_ADMIN_DISPLAY_NAME=Staging审核员
STAGING_ONBOARDING_USER_OPENID=staging-clinic-onboarding-user-001
STAGING_ONBOARDING_USER_NICKNAME=Staging链路验收用户

LOG_LEVEL=info
LOG_DIR=logs

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana

NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3001
LOKI_PORT=3100
