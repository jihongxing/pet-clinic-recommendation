# ============================================
# 后端本地开发环境变量模板
# 复制为 backend/.env 后使用：
#   Copy-Item .env.example .env
# ============================================

# ============================================
# 应用配置
# ============================================
NODE_ENV=development
PORT=3000
APP_NAME=pet-clinic-recommendation-backend
TRUST_PROXY=false

# ============================================
# 数据库配置 (PostgreSQL)
# ============================================
DB_TYPE=postgres
# 直连容器时可改成 postgres；本机直连可用 localhost
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres_password
DB_DATABASE=pet_clinic_recommendation

# ============================================
# Redis配置
# ============================================
# 直连容器时可改成 redis；本机直连可用 localhost
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# JWT配置
# ============================================
JWT_SECRET=dev_only_change_me
JWT_EXPIRES_IN=7d

# ============================================
# 微信小程序配置
# ============================================
# 本地开发未联调微信登录前可留空
WECHAT_APPID=
WECHAT_SECRET=

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=info
LOG_DIR=./logs

# ============================================
# 缓存配置
# ============================================
CACHE_TTL_CLINIC_LIST=300        # 诊所列表缓存时间（秒）
CACHE_TTL_CLINIC_DETAIL=600      # 诊所详情缓存时间（秒）
CACHE_TTL_TAGS=3600              # 标签列表缓存时间（秒）

# ============================================
# 限流配置
# ============================================
RATE_LIMIT_READ=100              # 读接口限流（次/分钟/用户）
RATE_LIMIT_WRITE=20              # 写接口限流（次/分钟/用户）
RATE_LIMIT_TAG_SUBMIT=5          # 提交标签限流（次/小时/用户）

# ============================================
# 分数计算配置
# ============================================
SCORE_WEIGHT_TRUST=0.45          # 信任权重
SCORE_WEIGHT_VALUE=0.25          # 性价比权重
SCORE_WEIGHT_EXPERIENCE=0.15     # 体验权重
SCORE_WEIGHT_SOCIAL=0.15         # 社交证明权重
SCORE_RISK_PENALTY_PER_TAG=15    # 每个风险标签扣分
SCORE_BASE_SCORE=60              # 基准分数
SCORE_CONFIDENCE_THRESHOLD=20    # 置信度阈值

# ============================================
# 定时任务配置
# ============================================
CRON_SCORE_CALCULATION=*/5 * * * *        # 分数计算（每5分钟）
CRON_TAG_LIFECYCLE=0 0 * * *              # 标签生命周期（每天0点）
CRON_TAG_INFERENCE=0 2 * * *              # 系统推断（每天2点）
CRON_RISK_DETECTION=0 * * * *             # 风险检测（每小时）

# ============================================
# 异常检测配置
# ============================================
ABNORMAL_DEVICE_FREQUENCY=5      # 设备频率阈值（次/小时）
ABNORMAL_IP_FREQUENCY=10         # IP频率阈值（次/24小时）
ABNORMAL_PATTERN_SIMILARITY=0.9  # 模式相似度阈值

# ============================================
# 其他配置
# ============================================
CORS_ORIGIN=*
API_PREFIX=/api/v1
SWAGGER_ENABLED=true
SWAGGER_PATH=api-docs
