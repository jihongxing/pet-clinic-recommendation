# ============================================
# Root environment variables for podman/docker compose
# Copy to .env at the repository root before running:
#   podman compose up -d
# ============================================

# App
NODE_ENV=development
PORT=3000
TRUST_PROXY=false
SWAGGER_ENABLED=true
LOG_LEVEL=debug
LOG_DIR=logs

# Database
DB_USERNAME=postgres
DB_PASSWORD=postgres_password
DB_DATABASE=pet_clinic_recommendation

# JWT
JWT_SECRET=dev_only_change_me
JWT_EXPIRES_IN=7d

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123456
# Alertmanager local UI port is fixed to 9093 in docker-compose.yml.

# WeChat mini program
# Leave blank for local backend/bootstrap work.
WECHAT_APPID=
WECHAT_SECRET=
